
PORT=8088

# Log writer: "stdout" (default when empty) or "file". "file" writes to LOG_FILE_PATH and also to
# stdout. The file and its directory are created if missing.
LOG_WRITER=stdout
LOG_FILE_PATH=logs/app.log
# Exact frontend origin allowed to call the API from a browser. Leave empty to disable CORS.
CORS_ORIGIN=

#MYSQL_HOST=db
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_DATABASE_TEST=api_test
MYSQL_USER=
MYSQL_PASSWORD=
