package {{.LowerCase}}repository

import (
	"context"
	"errors"
	"fmt"

	"github.com/google/uuid"
	"github.com/jmoiron/sqlx"

	"{{.Module}}/internal/logga"
	"{{.Module}}/internal/model/{{.LowerCase}}"
	"{{.Module}}/internal/repository"
	req "{{.Module}}/internal/request"
	"{{.Module}}/internal/service"
)

type Repo struct {
	l *logga.Logga
}

func New(logger *logga.Logga) *Repo {
	return &Repo{
		l: logger,
	}
}

// Create assigns the record a new UUID and inserts it within the provided transaction.
func (r *Repo) Create(ctx context.Context, tx *sqlx.Tx, record *{{.LowerCase}}.{{.PascalCase}}) error {
	record.ID = uuid.New().String()

	_, err := tx.NamedExec(insertRecordSQL, record)
	if err != nil {
		errMsg := fmt.Sprintf("there was an error saving record to db. %s", err)
		r.l.Error(ctx, errMsg, nil)

		return errors.New(errMsg)
	}

	return nil
}

func (r *Repo) Update(ctx context.Context, tx *sqlx.Tx, record *{{.LowerCase}}.{{.PascalCase}}) error {
	_, err := tx.NamedExec(updateRecordSQL, record)
	if err != nil {
		errMsg := fmt.Sprintf("there was an error saving record to db. %s", err)
		r.l.Error(ctx, errMsg, nil)

		return errors.New(errMsg)
	}

	return nil
}

func (r *Repo) Delete(ctx context.Context, tx *sqlx.Tx, record *{{.LowerCase}}.{{.PascalCase}}) error {
	_, err := tx.NamedExec(deleteRecordSQL, record)
	if err != nil {
		errMsg := fmt.Sprintf("there was an error saving record to db. %s", err)
		r.l.Error(ctx, errMsg, nil)

		return errors.New(errMsg)
	}

	return nil
}

func (r *Repo) GetByID(ctx context.Context, db *sqlx.DB, id string, record *{{.LowerCase}}.{{.PascalCase}}) error {
	err := db.Get(record, selectByIDQuery, id)
	if err != nil {
		r.l.Error(ctx, service.UnableToRetrieveRecord, logga.KVPs{"ID": id})

		return fmt.Errorf("%s %s: %w", service.UnableToRetrieveRecord, id, err)
	}

	return nil
}

func (r *Repo) GetCollection(ctx context.Context, db *sqlx.DB, p *req.Request) ([]*{{.LowerCase}}.{{.PascalCase}}, error) {
	var (
		records []*{{.LowerCase}}.{{.PascalCase}}
		err     error
	)

	countQ, countParams := repository.BuildQuery(selectCollectionCountQuery, p, true)
	count, err := repository.GetRecordCount(db, countQ, countParams)
	if err != nil {
		r.l.Error(ctx, "GetCollection()", logga.KVPs{"err": err})
	}
	p.SetRecordCount(count)

	q, params := repository.BuildQuery(selectCollectionQuery, p, false)
	err = db.Select(&records, q, params...)
	if err != nil {
		return records, fmt.Errorf("%s: %s", service.UnableToRetrieveRecord, err.Error())
	}

	return records, nil
}
