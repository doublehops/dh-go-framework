package {{.LowerCase}}

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"

	"github.com/jinzhu/copier"
	"github.com/julienschmidt/httprouter"

	"{{.Module}}/internal/handlers"
	model "{{.Module}}/internal/model/{{.LowerCase}}"
	req "{{.Module}}/internal/request"
	"{{.Module}}/internal/service"
	"{{.Module}}/internal/service/{{.LowerCase}}service"
)

type Handle struct {
	srv  *{{.LowerCase}}service.{{.ServiceName}}
	base *handlers.BaseHandler
}

func New(app *service.App) *Handle {
	return &Handle{
		srv: {{.LowerCase}}service.New(app),
		base: &handlers.BaseHandler{
			Log: app.Log,
		},
	}
}

func (h *Handle) Create(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
	ctx := r.Context()
	h.base.Log.Info(ctx, "Request made to Create{{.PascalCase}}", nil)

	record := &model.{{.PascalCase}}{}
	if err := json.NewDecoder(r.Body).Decode(record); err != nil {
		h.base.WriteJSON(ctx, w, http.StatusBadRequest, req.UnableToParseResp())

		return
	}

	record.Normalise()

	if errs := record.Validate(); len(errs) > 0 {
		h.base.WriteJSON(ctx, w, http.StatusBadRequest, req.GetValidateErrResp(errs, req.ErrValidation.Error()))

		return
	}

	rec, err := h.srv.NewRecord(record).Create(ctx)
	if err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ServerErrResp(req.ErrProcessingRequest.Error()))

		return
	}

	h.writeRecord(ctx, w, http.StatusCreated, rec.Record)
}

// getAccessibleRecord loads the record named by the :id route param and checks the requesting user
// may access it. On failure it writes the 404/403 response itself and returns nil.
func (h *Handle) getAccessibleRecord(w http.ResponseWriter, r *http.Request, ps httprouter.Params) *{{.LowerCase}}service.{{.PascalCase}}Record {
	ctx := r.Context()

	rec, err := h.srv.GetByID(ctx, ps.ByName("id"))
	if err != nil {
		h.base.WriteJSON(ctx, w, http.StatusNotFound, req.GetNotFoundResp())

		return nil
	}

	if !rec.CanBeAccessedBy(h.base.GetRequestingUserRecord(ctx)) {
		h.base.WriteJSON(ctx, w, http.StatusForbidden, req.GetNotAuthorisedResp())

		return nil
	}

	return rec
}

func (h *Handle) UpdateByID(w http.ResponseWriter, r *http.Request, ps httprouter.Params) {
	ctx := r.Context()
	h.base.Log.Info(ctx, "Request made to Update{{.PascalCase}}", nil)

	rec := h.getAccessibleRecord(w, r, ps)
	if rec == nil {
		return
	}

	payload := &model.{{.PascalCase}}{}
	if err := json.NewDecoder(r.Body).Decode(payload); err != nil {
		h.base.WriteJSON(ctx, w, http.StatusBadRequest, req.UnableToParseResp())

		return
	}

	payload.Normalise()

	if errs := payload.Validate(); len(errs) > 0 {
		h.base.WriteJSON(ctx, w, http.StatusBadRequest, req.GetValidateErrResp(errs, req.ErrValidation.Error()))

		return
	}

	if err := rec.Update(ctx, payload); err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ErrorProcessingRequestResp())

		return
	}

	h.writeRecord(ctx, w, http.StatusOK, rec.Record)
}

func (h *Handle) DeleteByID(w http.ResponseWriter, r *http.Request, ps httprouter.Params) {
	ctx := r.Context()
	h.base.Log.Info(ctx, "Request made to Delete{{.PascalCase}}", nil)

	rec := h.getAccessibleRecord(w, r, ps)
	if rec == nil {
		return
	}

	if err := rec.Delete(ctx); err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ErrorProcessingRequestResp())

		return
	}

	h.base.WriteJSON(ctx, w, http.StatusNoContent, nil)
}

func (h *Handle) GetByID(w http.ResponseWriter, r *http.Request, ps httprouter.Params) {
	ctx := r.Context()
	h.base.Log.Info(ctx, "Request made to Get{{.PascalCase}}", nil)

	rec := h.getAccessibleRecord(w, r, ps)
	if rec == nil {
		return
	}

	h.writeRecord(ctx, w, http.StatusOK, rec.Record)
}

func filterRules() []req.FilterRule {
	return []req.FilterRule{
		{
			Field: "deletedAt",
			Type:  req.FilterIsNull,
		},
	}
}

// getSortableFields will return a list of fields that a collection of records can be sorted by. This is necessary because
// not all fields should this be available to, and it will prevent SQL injection.
func getSortableFields() []string {
	return []string{
		"id",
		"createdAt",
		"updatedAt",
	}
}

func (h *Handle) GetAll(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
	ctx := r.Context()
	h.base.Log.Info(ctx, "Request made to Get{{.PascalCase}}Collection", nil)

	p := req.GetRequestParams(r, filterRules(), getSortableFields())

	records, err := h.srv.GetAll(ctx, p)
	if err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ErrorProcessingRequestResp())

		return
	}

	response, err := h.GetCollectionResponse(ctx, records)
	if err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ServerErrResp("error building response object"))

		return
	}

	h.base.WriteJSON(ctx, w, http.StatusOK, req.GetListResp(response, p))
}

// writeRecord writes a single record as its Response{{.PascalCase}} shape.
func (h *Handle) writeRecord(ctx context.Context, w http.ResponseWriter, status int, record *model.{{.PascalCase}}) {
	response, err := h.GetResponse(ctx, record)
	if err != nil {
		h.base.WriteJSON(ctx, w, http.StatusInternalServerError, req.ServerErrResp("error building response object"))

		return
	}

	h.base.WriteJSON(ctx, w, status, req.GetSingleItemResp(response))
}

func (h *Handle) GetResponse(ctx context.Context, record *model.{{.PascalCase}}) (*model.Response{{.PascalCase}}, error) {
	res := &model.Response{{.PascalCase}}{}
	if err := copier.Copy(res, record); err != nil {
		h.base.Log.Error(ctx, "error building response object", nil)

		return nil, errors.New("error building response object")
	}

	return res, nil
}

func (h *Handle) GetCollectionResponse(ctx context.Context, records []*model.{{.PascalCase}}) ([]*model.Response{{.PascalCase}}, error) {
	response := []*model.Response{{.PascalCase}}{}
	for _, record := range records {
		res, err := h.GetResponse(ctx, record)
		if err != nil {
			return nil, err
		}

		response = append(response, res)
	}

	return response, nil
}
