package {{.LowerCase}}service

import (
	"context"

	"{{.Module}}/internal/model/{{.LowerCase}}"
	"{{.Module}}/internal/repository/{{.LowerCase}}repository"
	req "{{.Module}}/internal/request"
	"{{.Module}}/internal/service"
)

// {{.ServiceName}} handles collection-level operations. Operations on a single record live on
// {{.PascalCase}}Record (see {{.LowerCase}}record.go).
type {{.ServiceName}} struct {
	*service.App
	{{.CamelCase}}Repo {{.RepositoryName}}
}

// New creates a new {{.ServiceName}}, wiring its own repository internally.
func New(app *service.App) *{{.ServiceName}} {
	return &{{.ServiceName}}{
		App:      app,
		{{.CamelCase}}Repo: {{.LowerCase}}repository.New(app.Log),
	}
}

// NewRecord wraps a bare model in a {{.PascalCase}}Record.
func (s *{{.ServiceName}}) NewRecord(record *{{.LowerCase}}.{{.PascalCase}}) *{{.PascalCase}}Record {
	return &{{.PascalCase}}Record{Record: record, svc: s}
}

// GetByID retrieves a record by its ID. An error is returned when it doesn't exist.
func (s *{{.ServiceName}}) GetByID(ctx context.Context, id string) (*{{.PascalCase}}Record, error) {
	record := &{{.LowerCase}}.{{.PascalCase}}{}
	if err := s.{{.CamelCase}}Repo.GetByID(ctx, s.DB, id, record); err != nil {
		s.Log.Error(ctx, service.UnableToRetrieveRecord+" "+err.Error(), nil)

		return nil, err
	}

	return s.NewRecord(record), nil
}

// GetAll retrieves a paginated collection of records.
func (s *{{.ServiceName}}) GetAll(ctx context.Context, p *req.Request) ([]*{{.LowerCase}}.{{.PascalCase}}, error) {
	records, err := s.{{.CamelCase}}Repo.GetCollection(ctx, s.DB, p)
	if err != nil {
		s.Log.Error(ctx, service.UnableToRetrieveRecord+" "+err.Error(), nil)

		return nil, err
	}

	return records, nil
}
