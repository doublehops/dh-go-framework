{
  "host": {
    "port": "ENV:PORT",
    "corsOrigin": "ENV:CORS_ORIGIN"
  },
  "logging": {
    "writer": "stdout",
    "logLevel": "debug",
    "outputFormat": "text"
  },
  "database": {
    "host": "ENV:MYSQL_HOST",
    "name": "ENV:MYSQL_DATABASE",
    "user": "ENV:MYSQL_USER",
    "password": "ENV:MYSQL_PASSWORD"
  }
}
